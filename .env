# PostgreSQL-Datenbankverbindung
DATABASE_HOST=localhost        # weil BE nicht im Docker
PG_USER=AdminUser         # Benutzername für PostgreSQL
PG_PASSWORD=AdminPassword # Passwort für PostgreSQL
PG_NAME=postgre_eventdb       # Name der PostgreSQL-Datenbank
PG_PORT=5432             # Port für PostgreSQL

MONGO_DOCKER_URI=mongodb://mongodb:27017/mongo_eventdb
# MongoDB-Datenbankverbindung
MONGO_URI=mongodb://localhost:27017/mongo_eventdb  # Verbindung zur MongoDB-Datenbank
MONGO_DB_NAME=mongo_eventdb                      # Name der MongoDB-Datenbank
MONGO_PORT=27017

# Allgemeine Einstellungen
PORT=3000  # Port für den Express-Server

PORT_FE=4200
