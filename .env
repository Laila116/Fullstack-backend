# PostgreSQL-Datenbankverbindung
PG_HOST=localhost        # weil BE nicht im Docker
PG_USER=postgres         # Benutzername für PostgreSQL
PG_PASSWORD=eventPostgres # Passwort für PostgreSQL
PG_NAME=mydatabase       # Name der PostgreSQL-Datenbank
PG_PORT=5432             # Port für PostgreSQL

# MongoDB-Datenbankverbindung
MONGO_URI=mongodb://mongodb:27017/mydatabase  # Verbindung zur MongoDB-Datenbank
MONGO_DB_NAME=mydatabase                      # Name der MongoDB-Datenbank

# Allgemeine Einstellungen
PORT=3000  # Port für den Express-Server
