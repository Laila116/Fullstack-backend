{
  "compilerOptions": {
    "target": "ES6",          
    "module": "commonjs",     
    "outDir": "./dist",       
    "strict": true,           
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "src/**/*", 
    "shared/**/*"
  ],
  "exclude": ["node_modules"]
}  