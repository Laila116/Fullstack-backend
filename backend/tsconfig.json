{
  "compilerOptions": {
    "target": "ES6",          
    "module": "commonjs",     
    "outDir": "./dist",       
    //"rootDir": "./src",
    "strict": true,           
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "baseUrl": "./src",  // Setzt das Arbeitsverzeichnis als Basis
    "paths": {
      "@shared/*": ["../../shared/*"]  // Verweist auf das Submodul shared
    }
  },
  "include": [
    "src/**/*",     // Schließt die Backend-Quelldateien ein
   "../../shared/**/*" // Schließt das Submodul shared ein
  ],
  "exclude": ["node_modules"]
}  